# Public Firebase web configuration (safe to expose in a built web app, but
# use placeholders here so this template never drifts into a live project).
VITE_FIREBASE_API_KEY=replace-with-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id
VITE_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key

# Local App Check debugging only. Never commit a real debug token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Supply either the plain local value (the build hashes it) or the matching
# precomputed hash. Production values belong in protected repository settings.
VTS_EDEN_VOTES_PIN=
VTS_EDEN_VOTES_PIN_HASH=
VTS_ADMIN_OVERRIDE_CODE=
VTS_ADMIN_OVERRIDE_HASH=
