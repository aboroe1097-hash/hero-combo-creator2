    function validAllStarBohPublishedPhaseItem(values, index) {
      return values.size() <= index
        || (
          values[index] is map
          && values[index].keys().hasOnly([
            'id', 'label', 'order', 'startMinute', 'endMinute'
          ])
          && values[index].keys().hasAll([
            'id', 'label', 'order', 'startMinute', 'endMinute'
          ])
          && values[index].id is string
          && values[index].id.matches('^[A-Za-z0-9_-]{1,128}$')
          && validAllStarBohText(values[index].label, 160)
          && values[index].label.size() > 0
          && values[index].order is int
          && values[index].order >= 0
          && values[index].order <= 100
          && (values[index].startMinute is int || values[index].startMinute is float)
          && values[index].startMinute >= 0
          && values[index].startMinute <= 180
          && (values[index].endMinute is int || values[index].endMinute is float)
          && values[index].endMinute >= 0
          && values[index].endMinute <= 180
          && values[index].endMinute > values[index].startMinute
        );
