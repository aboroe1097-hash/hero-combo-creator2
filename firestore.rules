      && data.status in ['hidden', 'announcement', 'plan', 'live']
      && validAllStarBohText(data.eventName, 160)
      && validAllStarBohText(data.title, 160)
      && validAllStarBohText(data.subtitle, 800)
      && validAllStarBohText(data.message, 2000)
      && data.announcementPublished is bool
