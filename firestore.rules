    function validAllStarBohFightingTimeIds(values) {
      return values is list
        && values.size() == 2
        && values.toSet().size() == values.size()
        && values.toSet().hasOnly(['+8', '+12', '+14', '+20']);
    }

    function validAllStarBohStats(stats) {
      return stats is map
        && stats.keys().hasOnly([
          'totalCastlePower', 'troopPower', 'buildingPower', 'technologyPower',
          'heroCombatPower', 'dragonPower', 't9TroopTypes', 'readySpeedHeroes',
          'level50HeroCount', 'rocLevel', 'usableHeroNames',
          'researchProgressPct'
        ])
        && stats.keys().hasAll([
          'totalCastlePower', 'troopPower', 'buildingPower', 'technologyPower',
          'heroCombatPower', 'dragonPower', 't9TroopTypes', 'readySpeedHeroes',
          'level50HeroCount', 'rocLevel'
        ])
        && validAllStarBohNullableInt(stats.totalCastlePower, 0, 1000000000000000)
        && validAllStarBohNullableInt(stats.troopPower, 0, 1000000000000000)
        && validAllStarBohNullableInt(stats.buildingPower, 0, 1000000000000000)
        && validAllStarBohNullableInt(stats.technologyPower, 0, 1000000000000000)
        && validAllStarBohNullableInt(stats.heroCombatPower, 0, 1000000000000000)
        && validAllStarBohNullableInt(stats.dragonPower, 0, 1000000000000000)
        && validAllStarBohStringList(stats.t9TroopTypes, 12, 60)
        && validAllStarBohStringList(stats.readySpeedHeroes, 24, 80)
        && validAllStarBohNullableInt(stats.level50HeroCount, 0, 500)
        && validAllStarBohNullableInt(stats.rocLevel, 0, 100)
        && (
          !('usableHeroNames' in stats)
          || validAllStarBohUsableHeroNames(stats.usableHeroNames)
        )
        && (
          !('researchProgressPct' in stats)
          || validAllStarBohResearchProgress(stats.researchProgressPct)
        );
    }

    function validAllStarBohCommitment(commitment) {
      return commitment is map
        && commitment.keys().hasOnly([
          'availability', 'preferredRole', 'unavailableTimes', 'canTeleport',
          'canUseVoice', 'planCommitment', 'notes', 'fightingTimeIds'
        ])
        && commitment.keys().hasAll([
          'availability', 'preferredRole', 'unavailableTimes', 'canTeleport',
          'canUseVoice', 'planCommitment', 'notes'
        ])
        && commitment.availability in ['all', 'most', 'backup', 'unavailable', '']
        && commitment.preferredRole in [
          'flexible', 'offensive', 'rune', 'top', 'bottom', 'backup', ''
        ]
        && validAllStarBohText(commitment.unavailableTimes, 800)
        && validAllStarBohNullableBool(commitment.canTeleport)
        && validAllStarBohNullableBool(commitment.canUseVoice)
        && validAllStarBohNullableBool(commitment.planCommitment)
        && validAllStarBohText(commitment.notes, 2000)
        && (
          !('fightingTimeIds' in commitment)
          || validAllStarBohFightingTimeIds(commitment.fightingTimeIds)
        );
    }

    function validAllStarBohEpicLanePreferences(values) {
      return values is list
        && values.size() > 0
        && values.size() <= 3
        && values.toSet().size() == values.size()
        && values.toSet().hasOnly(['south', 'center', 'north']);
    }

    function validAllStarBohEpicTimePreferences(values) {
      return values is list
        && values.size() > 0
        && values.size() <= 3
        && values.toSet().size() == values.size()
        && values.toSet().hasOnly(['+8', '+10', '+12']);
    }

    function validAllStarBohEpicPreferences(season, uid) {
      return request.resource.data.keys().hasOnly([
        'gameName', 'lanePreferences', 'timePreferences',
        'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.keys().hasAll([
        'gameName', 'lanePreferences', 'timePreferences',
        'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt', 'updatedBy'
      ])
      && validAllStarBohText(request.resource.data.gameName, 160)
      && request.resource.data.gameName.size() > 0
      && validAllStarBohEpicLanePreferences(
        request.resource.data.lanePreferences
      )
      && validAllStarBohEpicTimePreferences(
        request.resource.data.timePreferences
      )
      && request.resource.data.seasonId == season
      && request.resource.data.uid == uid
      && request.resource.data.schemaVersion == 1
      && request.resource.data.revision is int
      && request.resource.data.revision > 0
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt == request.time
      && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAllStarBohEpicPreferencesCreate(season, uid) {
      return validAllStarBohEpicPreferences(season, uid)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time;
    }

    function validAllStarBohEpicPreferencesUpdate(season, uid) {
      return validAllStarBohEpicPreferences(season, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'gameName', 'lanePreferences', 'timePreferences',
          'revision', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
    }

    function validAllStarBohFieldConfidence(fieldConfidence) {
      return fieldConfidence is map
        && fieldConfidence.keys().hasOnly([
          'totalCastlePower', 'troopPower', 'buildingPower',
          'technologyPower', 'heroCombatPower', 'dragonPower'
        ])
        && (!('totalCastlePower' in fieldConfidence)
          || validAllStarBohNullableNumber(fieldConfidence.totalCastlePower, 0, 1))
        && (!('troopPower' in fieldConfidence)
          || validAllStarBohNullableNumber(fieldConfidence.troopPower, 0, 1))
        && (!('buildingPower' in fieldConfidence)
          || validAllStarBohNullableNumber(fieldConfidence.buildingPower, 0, 1))
        && (!('technologyPower' in fieldConfidence)
          || validAllStarBohNullableNumber(fieldConfidence.technologyPower, 0, 1))
        && (!('heroCombatPower' in fieldConfidence)
          || validAllStarBohNullableNumber(fieldConfidence.heroCombatPower, 0, 1))
        && (!('dragonPower' in fieldConfidence)
          || validAllStarBohNullableNumber(fieldConfidence.dragonPower, 0, 1));
    }

    function validAllStarBohOcr(ocr) {
      return ocr is map
        && ocr.keys().hasOnly([
          'used', 'valuesConfirmed', 'confidence', 'warnings', 'fieldConfidence'
        ])
        && ocr.keys().hasAll([
          'used', 'valuesConfirmed', 'confidence', 'warnings', 'fieldConfidence'
        ])
        && ocr.used is bool
        && ocr.valuesConfirmed is bool
        && validAllStarBohNullableNumber(ocr.confidence, 0, 1)
        && validAllStarBohStringList(ocr.warnings, 20, 240)
        && validAllStarBohFieldConfidence(ocr.fieldConfidence);
