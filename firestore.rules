rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Admin writes (dashboard/roster/conduct, eden_x1 vote moderation) require
    // the `admin` custom claim (set on the admin UID via
    // `node scripts/firebase-set-admin-claim.mjs <uid-or-email>`), NOT a mere
    // password sign-in. The public web API key lets anyone self-register a
    // password account via the Identity Toolkit REST API, so the provider check
    // was not a safe gate; the custom claim is the only thing an attacker
    // cannot forge. The client login gate mirrors this via isAdminAuthUser().

    function validComment() {
      return request.resource.data.keys().hasOnly([
        'text', 'name', 'state', 'parentId', 'authorId', 'createdAt', 'approved', 'public'
      ])
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 2000
      && (!('parentId' in request.resource.data)
        || request.resource.data.parentId == null
        || (request.resource.data.parentId is string
          && request.resource.data.parentId.matches('^[A-Za-z0-9_-]{1,150}$')))
      && (!('state' in request.resource.data)
        || (request.resource.data.state is string
          && request.resource.data.state.size() > 0
          && request.resource.data.state.size() <= 40))
      && request.resource.data.authorId == request.auth.uid
      && request.resource.data.approved == false
      && request.resource.data.public == true;
    }

    function isReadableComment() {
      return resource.data.approved == true
        && resource.data.public == true;
    }

    function canReadComment() {
      return signedIn()
        && (isReadableComment()
          || resource.data.authorId == request.auth.uid
          || isAdmin());
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly(['playerProfile'])
      && request.resource.data.playerProfile is map
      && request.resource.data.playerProfile.keys().hasOnly(['roster'])
      && request.resource.data.playerProfile.roster is list
      && request.resource.data.playerProfile.roster.size() <= 120;
    }

    function validBestCombo() {
      return request.resource.data.keys().hasOnly(['heroes', 'timestamp'])
      && request.resource.data.heroes is list
      && request.resource.data.heroes.size() == 3
      && request.resource.data.heroes[0] is string
      && request.resource.data.heroes[1] is string
      && request.resource.data.heroes[2] is string
      && request.resource.data.heroes[0].size() <= 80
      && request.resource.data.heroes[1].size() <= 80
      && request.resource.data.heroes[2].size() <= 80
      && request.resource.data.timestamp is timestamp;
    }

    // Arcade leaderboard rows: one doc per (game, auth user, local player profile) at
    // `{gameId}__{uid}__{playerId}`. This keeps multiple players on a shared device distinct.
    // Ownership is bound to the *server* auth uid (the client-supplied uid is only trusted
    // when it equals request.auth.uid), the doc id must encode that same (game, uid) pair,
    // and score is a plain non-negative int. Updates are gated separately so bests can only
    // increase.
    function validArcadeScore(scoreId) {
      return request.resource.data.keys().hasOnly([
        'gameId', 'uid', 'playerId', 'name', 'state', 'score', 'updatedAt'
      ])
      && request.resource.data.gameId is string
      && request.resource.data.gameId in [
        'merge_rush', 'sort_hoard', 'crystal_relay', 'set_assembly', 'hero_rumble'
      ]
      && request.resource.data.uid is string
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.playerId is string
      && request.resource.data.playerId.size() >= 12
      && request.resource.data.playerId.size() <= 40
      && scoreId == request.resource.data.gameId + '__' + request.auth.uid + '__' + request.resource.data.playerId
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 24
      && request.resource.data.state is string
      && request.resource.data.state.size() <= 12
      && request.resource.data.score is int
      && request.resource.data.score >= 0
      && request.resource.data.score <= 100000000
      && request.resource.data.updatedAt == request.time;
    }

    function validClientError() {
      return request.resource.data.keys().hasOnly([
        'source', 'error', 'extra', 'path', 'userAgent', 'createdAt', 'authorId', 'receivedAt'
      ])
      && request.resource.data.source is string
      && request.resource.data.source.size() > 0
      && request.resource.data.source.size() <= 120
      && request.resource.data.error is map
      && request.resource.data.error.keys().hasOnly(['name', 'message', 'stack'])
      && request.resource.data.error.name is string
      && request.resource.data.error.name.size() <= 120
      && request.resource.data.error.message is string
      && request.resource.data.error.message.size() <= 2000
      && request.resource.data.error.stack is string
      && request.resource.data.error.stack.size() <= 8000
      && request.resource.data.extra is map
      && request.resource.data.extra.keys().size() <= 12
      && request.resource.data.path is string
      && request.resource.data.path.size() <= 500
      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 500
      && request.resource.data.createdAt is string
      && request.resource.data.createdAt.size() <= 40
      && request.resource.data.authorId == request.auth.uid
      && request.resource.data.receivedAt == request.time;
    }

    function validSharedIntel() {
      return request.resource.data.keys().hasOnly(['guilds', 'status', 'updatedAt', 'updatedBy'])
      && (!('guilds' in request.resource.data) || request.resource.data.guilds is map)
      && (!('status' in request.resource.data) || request.resource.data.status is map)
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.updatedBy == 'eden-map-planner';
    }

    function validDashboardData() {
      return request.resource.data.keys().hasOnly([
        'updatedAtMs', 'syncRevision', 'last_updated', 'total_attacks', 'attacks', 'players_summary',
        'bannerRecords', 'dutyRecords', 'contributionRecords', 'exGuildContributions',
        'playerRegistry', 'r5Season', 'publicConductAdjustments'
      ])
      && request.resource.data.updatedAtMs is number
      && request.resource.data.syncRevision is int
      && request.resource.data.syncRevision > 0
      && (!('last_updated' in request.resource.data) || request.resource.data.last_updated is string)
      && (!('total_attacks' in request.resource.data) || request.resource.data.total_attacks is int)
      && (!('attacks' in request.resource.data) || request.resource.data.attacks is list)
      && (!('players_summary' in request.resource.data) || request.resource.data.players_summary is list)
      && (!('bannerRecords' in request.resource.data) || request.resource.data.bannerRecords is list)
      && (!('dutyRecords' in request.resource.data) || request.resource.data.dutyRecords is list)
      && (!('contributionRecords' in request.resource.data) || request.resource.data.contributionRecords is list)
      && (!('exGuildContributions' in request.resource.data) || request.resource.data.exGuildContributions is list)
      && (!('playerRegistry' in request.resource.data) || request.resource.data.playerRegistry is map)
      && (!('r5Season' in request.resource.data) || request.resource.data.r5Season is string)
      && (!('publicConductAdjustments' in request.resource.data) || request.resource.data.publicConductAdjustments is list);
    }

    function validAdminLogEvent(logId) {
      return request.resource.data.keys().hasOnly([
        'id', 'severity', 'source', 'messageKey', 'params', 'fallback', 'file',
        'clientCreatedAtMs', 'createdAt', 'expiresAt', 'createdBy', 'sessionId', 'sequence'
      ])
      && request.resource.data.id is string
      && request.resource.data.id == logId
      && request.resource.data.id.matches('^[A-Za-z0-9_-]{1,160}$')
      && request.resource.data.severity in ['info', 'warn', 'error', 'success']
      && request.resource.data.source in [
        'system', 'dashboard', 'ocr', 'roster', 'cloud', 'sync', 'import', 'export'
      ]
      && request.resource.data.messageKey is string
      && request.resource.data.messageKey.size() <= 120
      && (request.resource.data.messageKey == ''
        || request.resource.data.messageKey.matches('^[A-Za-z][A-Za-z0-9_.-]{0,119}$'))
      && request.resource.data.params is string
      && request.resource.data.params.size() <= 1500
      && request.resource.data.fallback is string
      && request.resource.data.fallback.matches(
        '^(system|dashboard|ocr|roster|cloud|sync|import|export) (info|warn|error|success) activity$'
      )
      && request.resource.data.file is string
      && request.resource.data.file == ''
      && request.resource.data.clientCreatedAtMs is int
      && request.resource.data.clientCreatedAtMs > 0
      && request.resource.data.createdAt == request.time
      && request.resource.data.expiresAt is timestamp
      && request.resource.data.expiresAt > request.time
      && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.sessionId is string
      && request.resource.data.sessionId.matches('^[A-Za-z0-9_-]{1,80}$')
      && request.resource.data.sequence is int
      && request.resource.data.sequence >= 0;
    }

    function validRosterData() {
      return request.resource.data.keys().hasOnly(['snapshots', 'updated'])
      && request.resource.data.snapshots is list
      && request.resource.data.snapshots.size() <= 50
      && request.resource.data.updated is string;
    }

    function validConductAdjustment() {
      return request.resource.data.keys().hasOnly([
        'id', 'season', 'playerKey', 'playerName', 'points', 'category', 'note', 'createdAt', 'createdBy'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() > 0
      && request.resource.data.id.size() <= 80
      && request.resource.data.season is string
      && request.resource.data.season.size() > 0
      && request.resource.data.season.size() <= 40
      && request.resource.data.playerKey is string
      && request.resource.data.playerKey.size() > 0
      && request.resource.data.playerKey.size() <= 120
      && request.resource.data.playerName is string
      && request.resource.data.playerName.size() > 0
      && request.resource.data.playerName.size() <= 120
      && request.resource.data.points is int
      && request.resource.data.points >= -1000
      && request.resource.data.points <= 1000
      && request.resource.data.category in [
        'banner_help', 'connected_road', 'extra_effort', 'merit_other',
        'path_block', 'toxicity', 'ignored_coordination', 'penalty_other',
        'forfeit_premium', 'grant_premium'
      ]
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.createdAt is timestamp
      && request.resource.data.createdBy is string
      && request.resource.data.createdBy.size() > 0
      && request.resource.data.createdBy.size() <= 128;
    }

    function validEdenX1Vote() {
      return request.resource.data.keys().hasOnly([
        'id', 'season', 'category', 'voterKey', 'voterName', 'candidateKey', 'candidateName',
        'candidateKeys', 'candidateNames', 'voterAuthUid', 'updatedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() > 0
      && request.resource.data.id.size() <= 180
      && request.resource.data.season is string
      && request.resource.data.season.size() > 0
      && request.resource.data.season.size() <= 40
      && request.resource.data.category == 'team_players'
      && request.resource.data.voterKey is string
      && request.resource.data.voterKey.size() > 0
      && request.resource.data.voterKey.size() <= 120
      && request.resource.data.voterName is string
      && request.resource.data.voterName.size() > 0
      && request.resource.data.voterName.size() <= 120
      && request.resource.data.candidateKey is string
      && request.resource.data.candidateKey.size() > 0
      && request.resource.data.candidateKey.size() <= 120
      && request.resource.data.candidateName is string
      && request.resource.data.candidateName.size() > 0
      && request.resource.data.candidateName.size() <= 120
      && request.resource.data.candidateKeys is list
      && request.resource.data.candidateKeys.size() >= 1
      && request.resource.data.candidateKeys.size() <= 4
      && request.resource.data.candidateKeys[0] is string
      && request.resource.data.candidateKeys[0].size() > 0
      && request.resource.data.candidateKeys[0].size() <= 120
      && (
        request.resource.data.candidateKeys.size() < 2
        || (
          request.resource.data.candidateKeys[1] is string
          && request.resource.data.candidateKeys[1].size() > 0
          && request.resource.data.candidateKeys[1].size() <= 120
          && request.resource.data.candidateKeys[0] != request.resource.data.candidateKeys[1]
        )
      )
      && (
        request.resource.data.candidateKeys.size() < 3
        || (
          request.resource.data.candidateKeys[2] is string
          && request.resource.data.candidateKeys[2].size() > 0
          && request.resource.data.candidateKeys[2].size() <= 120
          && request.resource.data.candidateKeys[0] != request.resource.data.candidateKeys[2]
          && request.resource.data.candidateKeys[1] != request.resource.data.candidateKeys[2]
        )
      )
      && (
        request.resource.data.candidateKeys.size() < 4
        || (
          request.resource.data.candidateKeys[3] is string
          && request.resource.data.candidateKeys[3].size() > 0
          && request.resource.data.candidateKeys[3].size() <= 120
          && request.resource.data.candidateKeys[0] != request.resource.data.candidateKeys[3]
          && request.resource.data.candidateKeys[1] != request.resource.data.candidateKeys[3]
          && request.resource.data.candidateKeys[2] != request.resource.data.candidateKeys[3]
        )
      )
      && request.resource.data.candidateNames is list
      && request.resource.data.candidateNames.size() == request.resource.data.candidateKeys.size()
      && request.resource.data.candidateNames.size() >= 1
      && request.resource.data.candidateNames.size() <= 4
      && request.resource.data.candidateNames[0] is string
      && request.resource.data.candidateNames[0].size() > 0
      && request.resource.data.candidateNames[0].size() <= 120
      && (
        request.resource.data.candidateNames.size() < 2
        || (
          request.resource.data.candidateNames[1] is string
          && request.resource.data.candidateNames[1].size() > 0
          && request.resource.data.candidateNames[1].size() <= 120
        )
      )
      && (
        request.resource.data.candidateNames.size() < 3
        || (
          request.resource.data.candidateNames[2] is string
          && request.resource.data.candidateNames[2].size() > 0
          && request.resource.data.candidateNames[2].size() <= 120
        )
      )
      && (
        request.resource.data.candidateNames.size() < 4
        || (
          request.resource.data.candidateNames[3] is string
          && request.resource.data.candidateNames[3].size() > 0
          && request.resource.data.candidateNames[3].size() <= 120
        )
      )
      && request.resource.data.candidateKey == request.resource.data.candidateKeys[0]
      && request.resource.data.candidateName == request.resource.data.candidateNames[0]
      && request.resource.data.voterAuthUid == request.auth.uid
      && request.resource.data.updatedAt == request.time;
    }

    function validEdenX1VotePath(voteId) {
      return request.resource.data.id == voteId
        && voteId == request.resource.data.season + '__team_players__' + request.resource.data.voterKey;
    }

    function canGetOwnEdenX1Vote(voteId) {
      return signedIn()
        && resource.data.id == voteId
        && resource.data.voterAuthUid == request.auth.uid;
    }

    function validEdenX1VoteHistoryPath(historyId) {
      return request.resource.data.id == historyId
        && request.resource.data.voteId == request.resource.data.season + '__team_players__' + request.resource.data.voterKey;
    }

    function validEdenX1VoteStringList(values, minSize) {
      return values is list
        && values.size() >= minSize
        && values.size() <= 4
        && (
          values.size() < 1
          || (values[0] is string && values[0].size() > 0 && values[0].size() <= 120)
        )
        && (
          values.size() < 2
          || (values[1] is string && values[1].size() > 0 && values[1].size() <= 120)
        )
        && (
          values.size() < 3
          || (values[2] is string && values[2].size() > 0 && values[2].size() <= 120)
        )
        && (
          values.size() < 4
          || (values[3] is string && values[3].size() > 0 && values[3].size() <= 120)
        );
    }

    function validEdenX1VoteHistory() {
      return request.resource.data.keys().hasOnly([
        'id', 'voteId', 'season', 'category', 'voterKey', 'voterName',
        'previousCandidateKeys', 'previousCandidateNames', 'candidateKeys', 'candidateNames',
        'voterAuthUid', 'action', 'createdAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() > 0
      && request.resource.data.id.size() <= 180
      && request.resource.data.voteId is string
      && request.resource.data.voteId.size() > 0
      && request.resource.data.voteId.size() <= 180
      && request.resource.data.season is string
      && request.resource.data.season.size() > 0
      && request.resource.data.season.size() <= 40
      && request.resource.data.category == 'team_players'
      && request.resource.data.voterKey is string
      && request.resource.data.voterKey.size() > 0
      && request.resource.data.voterKey.size() <= 120
      && request.resource.data.voterName is string
      && request.resource.data.voterName.size() > 0
      && request.resource.data.voterName.size() <= 120
      && validEdenX1VoteStringList(request.resource.data.previousCandidateKeys, 0)
      && validEdenX1VoteStringList(request.resource.data.previousCandidateNames, 0)
      && request.resource.data.previousCandidateNames.size() == request.resource.data.previousCandidateKeys.size()
      && validEdenX1VoteStringList(request.resource.data.candidateKeys, 1)
      && validEdenX1VoteStringList(request.resource.data.candidateNames, 1)
      && request.resource.data.candidateNames.size() == request.resource.data.candidateKeys.size()
      && request.resource.data.voterAuthUid == request.auth.uid
      && request.resource.data.action in ['created', 'updated']
      && request.resource.data.createdAt == request.time;
    }

    function validEdenX1VoteSettings() {
      return request.resource.data.keys().hasOnly([
        'season', 'votingOpen', 'allowEditing', 'showPublicResults',
        'showVoterNames', 'contributionRankingMode', 'closesAt', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.season is string
      && request.resource.data.season.size() > 0
      && request.resource.data.season.size() <= 40
      && request.resource.data.votingOpen is bool
      && request.resource.data.allowEditing is bool
      && request.resource.data.showPublicResults is bool
      && request.resource.data.showVoterNames is bool
      && (
        !('contributionRankingMode' in request.resource.data)
        || (
          request.resource.data.contributionRankingMode is string
          && request.resource.data.contributionRankingMode in ['extended', 'default']
        )
      )
      && (
        !('closesAt' in request.resource.data)
        || (
          request.resource.data.closesAt is string
          && request.resource.data.closesAt.size() <= 24
          && request.resource.data.closesAt.matches(
            '^$|^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$'
          )
        )
      )
      && request.resource.data.updatedAt == request.time
      && request.resource.data.updatedBy == request.auth.uid;
    }

    function validEdenX1PublicVoteResults() {
      return request.resource.data.keys().hasOnly([
        'season', 'published', 'rankings', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.season is string
      && request.resource.data.season.size() > 0
      && request.resource.data.season.size() <= 40
      && request.resource.data.published is bool
      && request.resource.data.rankings is list
      && request.resource.data.rankings.size() <= 100
      && request.resource.data.updatedAt == request.time
      && request.resource.data.updatedBy == request.auth.uid;
    }

    function hasStableConductMetadata() {
      return ('createdAt' in resource.data)
        && resource.data.createdAt is timestamp
        && ('createdBy' in resource.data)
        && resource.data.createdBy is string
        && resource.data.createdBy.size() > 0
        && resource.data.createdBy != 'release-13.1.0';
    }

    function keepsConductMetadata() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function repairsHistoricalConductMetadata() {
      return !hasStableConductMetadata()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /comments/{commentId} {
      allow read: if canReadComment();
      allow create: if signedIn() && validComment();
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.approved == false;
      allow update: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserProfile();
      allow delete: if false;

      match /bestCombos/{comboId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validBestCombo();
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /errors/{errorId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && validClientError();
      allow update: if false;
    }

    match /eden_map/shared_intel {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validSharedIntel();
      allow delete: if false;
    }

    match /vts_admin/dashboard_data {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validDashboardData()
        && request.resource.data.syncRevision == 1;
      allow update: if isAdmin()
        && validDashboardData()
        && (
          (!('syncRevision' in resource.data)
            && request.resource.data.syncRevision == 1)
          || ('syncRevision' in resource.data
            && request.resource.data.syncRevision == resource.data.syncRevision + 1)
        )
        && (!('updatedAtMs' in resource.data)
          || request.resource.data.updatedAtMs >= resource.data.updatedAtMs);
      allow delete: if false;
    }

    match /vts_admin/roster_data {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validRosterData();
      allow delete: if false;
    }

    match /vts_admin/log_store/admin_log_events/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAdminLogEvent(logId);
      allow update, delete: if false;
    }

    match /vts_admin/conduct_adjustments/records/{adjustmentId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validConductAdjustment()
        && request.resource.data.id == adjustmentId
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validConductAdjustment()
        && request.resource.data.id == adjustmentId
        && (keepsConductMetadata() || repairsHistoricalConductMetadata());
      allow delete: if isAdmin();
    }

    match /vts_admin/eden_x1_votes/records/{voteId} {
      allow get: if isAdmin() || canGetOwnEdenX1Vote(voteId);
      allow list, delete: if isAdmin();
      allow create: if signedIn()
        && validEdenX1Vote()
        && validEdenX1VotePath(voteId);
      allow update: if signedIn()
        && validEdenX1Vote()
        && validEdenX1VotePath(voteId)
        && (isAdmin() || resource.data.voterAuthUid == request.auth.uid);
    }

    match /vts_admin/eden_x1_vote_history/records/{historyId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && validEdenX1VoteHistory()
        && validEdenX1VoteHistoryPath(historyId);
      allow update, delete: if false;
    }

    match /vts_admin/eden_x1_vote_settings {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validEdenX1VoteSettings();
      allow delete: if false;
    }

    match /vts_admin/eden_x1_public_vote_results {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validEdenX1PublicVoteResults();
      allow delete: if false;
    }

    match /arcade_scores/{scoreId} {
      // Any signed-in (incl. anonymous) visitor can read the leaderboard.
      allow read: if signedIn();
      // Owner creates their own row; the doc id + uid field are pinned to their auth uid.
      allow create: if signedIn() && validArcadeScore(scoreId);
      // Owner updates their own row, and only to a higher-or-equal best (monotonic).
      allow update: if signedIn()
        && validArcadeScore(scoreId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    match /vts_admin/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
