        'announcementPublished', 'planPublished', 'activePlanRevision',
        'teamCount', 'rosterSize', 'teamIds', 'phases', 'legions',
        'seasonId', 'schemaVersion', 'revision', 'createdAt', 'updatedAt', 'updatedBy'
