        && validAllStarBohStringItem(values, 22, maxLength)
        && validAllStarBohStringItem(values, 23, maxLength)
        && validAllStarBohStringItem(values, 24, maxLength)
        && validAllStarBohStringItem(values, 25, maxLength)
        && validAllStarBohStringItem(values, 26, maxLength)
        && validAllStarBohStringItem(values, 27, maxLength)
        && validAllStarBohStringItem(values, 28, maxLength)
        && validAllStarBohStringItem(values, 29, maxLength);
    }

    function validAllStarBohNullableInt(value, minimum, maximum) {
      return value == null
        || (value is int && value >= minimum && value <= maximum);
    }

    function validAllStarBohNullableNumber(value, minimum, maximum) {
      return value == null
        || (
          (value is int || value is float)
          && value >= minimum
          && value <= maximum
        );
    }

    function validAllStarBohNullableBool(value) {
      return value == null || value is bool;
    }

    function validAllStarBohUsableHeroNames(values) {
