        && validAllStarBohStringItem(values, 10, maxLength)
        && validAllStarBohStringItem(values, 11, maxLength)
        && validAllStarBohStringItem(values, 12, maxLength)
        && validAllStarBohStringItem(values, 13, maxLength)
        && validAllStarBohStringItem(values, 14, maxLength)
        && validAllStarBohStringItem(values, 15, maxLength)
        && validAllStarBohStringItem(values, 16, maxLength)
        && validAllStarBohStringItem(values, 17, maxLength)
