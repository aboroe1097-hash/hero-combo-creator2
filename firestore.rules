    function validAllStarBohIdentifier(value, allowEmpty) {
      return value is string
        && (
          (allowEmpty && value.size() == 0)
          || value.matches('^[A-Za-z0-9_-]{1,128}$')
        );
    }

    function validAllStarBohShortIdentifierList(values) {
      return values is list
        && values.size() <= 30;
    }

    function validAllStarBohPublishedInstruction(instruction) {
      return instruction is map
        && instruction.keys().hasOnly([
          'summary', 'action', 'target', 'startObjectiveId', 'objectiveId',
          'targetLabel', 'loadout', 'teleport', 'note', 'priority',
          'viaObjectiveIds', 'pathObjectiveIds'
        ])
        && instruction.keys().hasAll([
          'summary', 'action', 'target', 'startObjectiveId', 'objectiveId',
          'targetLabel', 'loadout', 'teleport', 'note', 'priority',
          'viaObjectiveIds', 'pathObjectiveIds'
        ])
        && validAllStarBohText(instruction.summary, 2000)
        && validAllStarBohText(instruction.action, 100)
        && validAllStarBohText(instruction.target, 240)
        && validAllStarBohIdentifier(instruction.startObjectiveId, true)
        && validAllStarBohIdentifier(instruction.objectiveId, true)
        && validAllStarBohText(instruction.targetLabel, 160)
        && validAllStarBohText(instruction.loadout, 240)
        && (
          instruction.teleport == null
          || instruction.teleport is bool
          || validAllStarBohText(instruction.teleport, 240)
        )
        && validAllStarBohText(instruction.note, 2000)
        && validAllStarBohNullableInt(instruction.priority, 0, 100)
        && validAllStarBohShortIdentifierList(instruction.viaObjectiveIds)
        && validAllStarBohShortIdentifierList(instruction.pathObjectiveIds);
    }

    function validAllStarBohPublishedTimelineItem(values, index, uid, teamId, baseSeatNumber) {
      return values.size() <= index
        || (
          values[index] is map
          && values[index].keys().hasOnly([
            'teamId', 'playerId', 'gameName', 'phaseId', 'phaseLabel',
            'startMinute', 'endMinute', 'legionId', 'legionLabel',
            'seatNumber', 'baseSeatNumber', 'roleGroupId', 'roleLabel',
            'rotated', 'instruction'
          ])
          && values[index].keys().hasAll([
            'teamId', 'playerId', 'gameName', 'phaseId', 'phaseLabel',
            'startMinute', 'endMinute', 'legionId', 'legionLabel',
            'seatNumber', 'baseSeatNumber', 'roleGroupId', 'roleLabel',
            'rotated', 'instruction'
          ])
          && values[index].teamId == teamId
          && values[index].playerId == uid
          && validAllStarBohText(values[index].gameName, 160)
          && validAllStarBohIdentifier(values[index].phaseId, false)
          && validAllStarBohText(values[index].phaseLabel, 160)
          && values[index].phaseLabel.size() > 0
          && (values[index].startMinute is int || values[index].startMinute is float)
          && values[index].startMinute >= 0
          && values[index].startMinute <= 180
          && (values[index].endMinute is int || values[index].endMinute is float)
          && values[index].endMinute >= 0
          && values[index].endMinute <= 180
          && values[index].endMinute > values[index].startMinute
          && validAllStarBohIdentifier(values[index].legionId, false)
          && validAllStarBohText(values[index].legionLabel, 160)
          && values[index].legionLabel.size() > 0
          && values[index].seatNumber is int
          && values[index].seatNumber >= 1
          && values[index].seatNumber <= 12
          && values[index].baseSeatNumber is int
          && values[index].baseSeatNumber == baseSeatNumber
          && validAllStarBohIdentifier(values[index].roleGroupId, false)
          && validAllStarBohText(values[index].roleLabel, 160)
          && values[index].roleLabel.size() > 0
          && values[index].rotated is bool
          && validAllStarBohPublishedInstruction(values[index].instruction)
        );
    }

    function validAllStarBohPublishedTimeline(values, uid, teamId, baseSeatNumber) {
      return values is list
        && values.size() == 8
        && validAllStarBohPublishedTimelineItem(values, 0, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 1, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 2, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 3, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 4, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 5, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 6, uid, teamId, baseSeatNumber)
        && validAllStarBohPublishedTimelineItem(values, 7, uid, teamId, baseSeatNumber);
    }

    function validAllStarBohPublishedRoleItem(values, index) {
      return values.size() <= index
        || (
          values[index] is map
          && values[index].keys().hasOnly(['id', 'label', 'order', 'color', 'capacity'])
          && values[index].keys().hasAll(['id', 'label', 'order', 'color', 'capacity'])
          && validAllStarBohIdentifier(values[index].id, false)
          && validAllStarBohText(values[index].label, 160)
          && values[index].label.size() > 0
          && values[index].order is int
          && values[index].order >= 0
          && values[index].order <= 100
          && validAllStarBohText(values[index].color, 40)
          && values[index].capacity is int
          && values[index].capacity >= 1
          && values[index].capacity <= 12
        );
    }

    function validAllStarBohPublishedRoles(values) {
      return values is list
        && values.size() <= 12
        && validAllStarBohPublishedRoleItem(values, 0)
        && validAllStarBohPublishedRoleItem(values, 1)
        && validAllStarBohPublishedRoleItem(values, 2)
        && validAllStarBohPublishedRoleItem(values, 3)
        && validAllStarBohPublishedRoleItem(values, 4)
        && validAllStarBohPublishedRoleItem(values, 5)
        && validAllStarBohPublishedRoleItem(values, 6)
        && validAllStarBohPublishedRoleItem(values, 7)
        && validAllStarBohPublishedRoleItem(values, 8)
        && validAllStarBohPublishedRoleItem(values, 9)
        && validAllStarBohPublishedRoleItem(values, 10)
        && validAllStarBohPublishedRoleItem(values, 11);
    }

    function validAllStarBohPublishedObjectives(values) {
      return values is list && values.size() <= 64;
    }

    function validAllStarBohPublishedPlan(plan) {
      return plan is map
        && plan.keys().hasOnly([
          'schemaVersion', 'id', 'label', 'roleGroups', 'phases', 'legions',
          'objectives', 'roleDefaults', 'seatOverrides', 'playerOverrides',
          'instructions', 'rotations', 'notes'
        ])
        && plan.keys().hasAll([
          'schemaVersion', 'id', 'label', 'roleGroups', 'phases', 'legions',
          'objectives', 'roleDefaults', 'seatOverrides', 'playerOverrides',
          'instructions', 'rotations', 'notes'
        ])
        && plan.schemaVersion == 1
        && validAllStarBohIdentifier(plan.id, true)
        && validAllStarBohText(plan.label, 160)
        && validAllStarBohPublishedRoles(plan.roleGroups)
        && validAllStarBohPublishedPhases(plan.phases)
        && plan.phases.size() == 4
        && validAllStarBohPublishedLegions(plan.legions)
        && plan.legions.size() == 2
        && validAllStarBohPublishedObjectives(plan.objectives)
        && plan.roleDefaults is list
        && plan.roleDefaults.size() == 0
        && plan.seatOverrides is list
        && plan.seatOverrides.size() == 0
        && plan.playerOverrides is list
        && plan.playerOverrides.size() == 0
        && plan.instructions is list
        && plan.instructions.size() == 0
        && plan.rotations is list
        && plan.rotations.size() == 0
        && plan.notes is list
        && plan.notes.size() == 0;
    }

    function validAllStarBohPublishedPlayerData(data, season, uid) {
      return data.keys().hasOnly([
        'playerId', 'displayName', 'teamId', 'teamName', 'teamNumber',
        'teamColor', 'seatNumber', 'roleGroupId', 'roleLabel', 'announcement',
        'plan', 'timeline', 'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt', 'updatedBy'
      ])
      && data.keys().hasAll([
        'playerId', 'displayName', 'teamId', 'teamName', 'teamNumber',
        'teamColor', 'seatNumber', 'roleGroupId', 'roleLabel', 'announcement',
        'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt', 'updatedBy'
      ])
      && data.playerId == uid
      && data.uid == uid
      && data.seasonId == season
      && data.schemaVersion == 1
      && validAllStarBohText(data.displayName, 160)
      && validAllStarBohIdentifier(data.teamId, false)
      && validAllStarBohText(data.teamName, 160)
      && data.teamNumber is int
      && data.teamNumber >= 1
      && data.teamNumber <= 6
      && validAllStarBohText(data.teamColor, 40)
      && data.seatNumber is int
      && data.seatNumber >= 1
      && data.seatNumber <= 12
      && validAllStarBohIdentifier(data.roleGroupId, true)
      && validAllStarBohText(data.roleLabel, 160)
      && validAllStarBohText(data.announcement, 2000)
      && (
        (
          !('plan' in data)
          && !('timeline' in data)
        )
        || (
          'plan' in data
          && 'timeline' in data
          && validAllStarBohPublishedPlan(data.plan)
          && validAllStarBohPublishedTimeline(
            data.timeline,
            uid,
            data.teamId,
            data.seatNumber
          )
        )
      )
      && data.revision is int
      && data.revision > 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.updatedBy is string
      && data.updatedBy.size() > 0
      && data.updatedBy.size() <= 128;
    }

    function validAllStarBohPublishedPlayerCreate(season, uid) {
      return validAllStarBohPublishedPlayerData(request.resource.data, season, uid)
        && request.resource.data.revision == getAfter(
          /databases/$(database)/documents/boh_allstar/$(season)/published/current
        ).data.revision
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAllStarBohPublishedPlayerUpdate(season, uid) {
      return validAllStarBohPublishedPlayerData(request.resource.data, season, uid)
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.revision == getAfter(
          /databases/$(database)/documents/boh_allstar/$(season)/published/current
        ).data.revision
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAllStarBohSubmission(season, uid) {
      return request.resource.data.keys().hasOnly([
        'playerId', 'gameName', 'knownNames', 'locale', 'timezone', 'entryMethod',
        'status', 'stats', 'preferredTeammates', 'rolePreferences',
        'eligibleRoleIds', 'commitment', 'ocr',
        'submittedAtMs', 'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.keys().hasAll([
        'playerId', 'gameName', 'knownNames', 'locale', 'timezone', 'entryMethod',
        'status', 'stats', 'rolePreferences', 'eligibleRoleIds', 'commitment', 'ocr',
        'submittedAtMs', 'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.playerId == uid
      && request.resource.data.uid == uid
      && request.resource.data.seasonId == season
      && request.resource.data.schemaVersion == 1
      && validAllStarBohText(request.resource.data.gameName, 160)
      && request.resource.data.gameName.size() > 0
      && validAllStarBohStringList(request.resource.data.knownNames, 30, 160)
      && validAllStarBohText(request.resource.data.locale, 20)
      && validAllStarBohText(request.resource.data.timezone, 80)
      && request.resource.data.entryMethod in ['manual', 'ocr']
      && request.resource.data.status in ['draft', 'submitted', 'withdrawn']
      && validAllStarBohStats(request.resource.data.stats)
      && (
        !('preferredTeammates' in request.resource.data)
        || validAllStarBohStringList(
          request.resource.data.preferredTeammates,
          6,
          160
        )
      )
      && validAllStarBohStringList(request.resource.data.rolePreferences, 12, 128)
      && validAllStarBohStringList(request.resource.data.eligibleRoleIds, 20, 128)
      && validAllStarBohCommitment(request.resource.data.commitment)
      && validAllStarBohOcr(request.resource.data.ocr)
      && validAllStarBohNullableInt(
        request.resource.data.submittedAtMs,
        0,
        9007199254740991
      )
      && request.resource.data.revision is int
      && request.resource.data.revision > 0
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt == request.time
      && request.resource.data.updatedBy == request.auth.uid
      && (
        request.resource.data.status != 'submitted'
        || request.resource.data.entryMethod != 'ocr'
        || (
          request.resource.data.ocr.used == true
          && request.resource.data.ocr.valuesConfirmed == true
        )
      );
    }

    function validAllStarBohSubmissionCreate(season, uid) {
      return validAllStarBohSubmission(season, uid)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time;
    }

    function validAllStarBohSubmissionUpdate(season, uid) {
      return validAllStarBohSubmission(season, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'gameName', 'knownNames', 'locale', 'timezone', 'entryMethod', 'status',
          'stats', 'preferredTeammates', 'rolePreferences', 'eligibleRoleIds',
          'commitment', 'ocr',
          'submittedAtMs', 'revision', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
    }

    function validAllStarBohFeedback(season, uid) {
      return request.resource.data.keys().hasOnly([
        'status', 'note', 'submissionRevision', 'reviewRevision',
        'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'status', 'note', 'submissionRevision', 'reviewRevision',
        'seasonId', 'uid', 'schemaVersion', 'revision',
        'createdAt', 'updatedAt'
      ])
      && request.resource.data.status in [
        'pending', 'confirmed', 'needs_correction', 'excluded'
      ]
      && validAllStarBohText(request.resource.data.note, 2000)
      && (
        !(request.resource.data.status in ['needs_correction', 'excluded'])
        || request.resource.data.note.size() > 0
      )
      && request.resource.data.submissionRevision is int
      && request.resource.data.submissionRevision > 0
      && request.resource.data.reviewRevision is int
      && request.resource.data.reviewRevision > 0
      && request.resource.data.seasonId == season
      && request.resource.data.uid == uid
      && request.resource.data.schemaVersion == 1
      && request.resource.data.revision is int
      && request.resource.data.revision > 0
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt == request.time;
    }

    function validAllStarBohFeedbackCreate(season, uid) {
      return validAllStarBohFeedback(season, uid)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time;
    }

    function validAllStarBohFeedbackUpdate(season, uid) {
      return validAllStarBohFeedback(season, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'note', 'submissionRevision', 'reviewRevision',
          'revision', 'updatedAt'
        ])
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
    }

    match /comments/{commentId} {
      allow read: if canReadComment();
      allow create: if signedIn() && validComment();
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.approved == false;
      allow update: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserProfile();
      allow delete: if false;

      match /bestCombos/{comboId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validBestCombo();
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /errors/{errorId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && validClientError();
      allow update: if false;
    }

    match /eden_map/shared_intel {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validSharedIntel();
      allow delete: if false;
    }

    match /boh_allstar_config/current {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validAllStarBohConfig();
      allow delete: if false;
    }

    match /boh_allstar_member_grants/{uid} {
      allow get: if canReadOwnActiveAllStarBohGrant(uid);
      allow list, create, update, delete: if false;
    }

    match /boh_allstar_security_attempts/{attemptId} {
      allow read, write: if isAdmin();
    }

    match /boh_allstar/{season} {
      allow read, write: if isAdmin();

      match /submissions/{uid} {
        allow get: if isAdmin() || (isOwner(uid) && hasActiveAllStarBohGrant(season));
        allow list: if isAdmin();
        allow create: if isOwner(uid)
          && hasActiveAllStarBohGrant(season)
          && validAllStarBohSubmissionCreate(season, uid);
        allow update: if isOwner(uid)
          && hasActiveAllStarBohGrant(season)
          && validAllStarBohSubmissionUpdate(season, uid);
        allow delete: if false;
      }

      match /reviews/{uid} {
        allow read, create, update: if isAdmin();
        allow delete: if false;
      }

      match /feedback/{uid} {
        allow get: if isAdmin() || (isOwner(uid) && hasActiveAllStarBohGrant(season));
        allow list: if false;
        allow create: if isAdmin() && validAllStarBohFeedbackCreate(season, uid);
        allow update: if isAdmin() && validAllStarBohFeedbackUpdate(season, uid);
        allow delete: if false;
      }

      match /epicPreferences/{uid} {
        allow get: if isAdmin()
          || (isOwner(uid) && hasActiveAllStarBohGrant(season));
        allow list: if isAdmin();
        allow create: if isOwner(uid)
          && hasActiveAllStarBohGrant(season)
          && validAllStarBohEpicPreferencesCreate(season, uid);
        allow update: if isOwner(uid)
          && hasActiveAllStarBohGrant(season)
          && validAllStarBohEpicPreferencesUpdate(season, uid);
        allow delete: if false;
      }

      match /drafts/{draftId} {
        allow read, write: if isAdmin();
      }

      match /draftTeams/{teamId} {
        allow read, write: if isAdmin();
      }

      match /published/current {
        allow get: if hasActiveAllStarBohGrant(season)
          && (isAdmin() || safeAllStarBohPublishedOverviewRead(season));
        allow list: if false;
        allow create: if isAdmin()
          && validAllStarBohPublishedOverviewCreate(season);
        allow update: if isAdmin()
          && validAllStarBohPublishedOverviewUpdate(season);
        allow delete: if isAdmin();
      }

      match /publishedTeams/{teamId} {
        allow get: if hasActiveAllStarBohGrant(season)
          && (isAdmin() || safeAllStarBohPublishedTeamRead(season, teamId));
        allow list: if false;
        allow create: if isAdmin()
          && validAllStarBohPublishedTeamCreate(season, teamId);
        allow update: if isAdmin()
          && validAllStarBohPublishedTeamUpdate(season, teamId);
        allow delete: if isAdmin();
      }

      match /publishedPlayers/{uid} {
        allow get: if isAdmin()
          || (
            isOwner(uid)
            && hasActiveAllStarBohGrant(season)
            && validAllStarBohPublishedPlayerData(resource.data, season, uid)
          );
        allow list: if false;
        allow create: if isAdmin()
          && validAllStarBohPublishedPlayerCreate(season, uid);
        allow update: if isAdmin()
          && validAllStarBohPublishedPlayerUpdate(season, uid);
        allow delete: if isAdmin();
      }
    }

    match /vts_admin/dashboard_data {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validDashboardData()
        && request.resource.data.syncRevision == 1;
      allow update: if isAdmin()
        && validDashboardData()
        && (
          (!('syncRevision' in resource.data)
            && request.resource.data.syncRevision == 1)
          || ('syncRevision' in resource.data
            && request.resource.data.syncRevision == resource.data.syncRevision + 1)
        )
        && (!('updatedAtMs' in resource.data)
          || request.resource.data.updatedAtMs >= resource.data.updatedAtMs);
      allow delete: if false;
    }

    match /vts_admin/roster_data {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validRosterData();
      allow delete: if false;
    }

    match /vts_admin/alliance_view/rosters/{allianceId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validAllianceViewRoster(allianceId)
        && request.resource.data.revision == 1;
      allow update: if isAdmin()
        && validAllianceViewRoster(allianceId)
        && resource.data.allianceId == allianceId
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /vts_admin/log_store/admin_log_events/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAdminLogEvent(logId);
      allow update, delete: if false;
    }

    match /vts_admin/conduct_adjustments/records/{adjustmentId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validConductAdjustment()
        && request.resource.data.id == adjustmentId
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validConductAdjustment()
        && request.resource.data.id == adjustmentId
        && (keepsConductMetadata() || repairsHistoricalConductMetadata());
      allow delete: if isAdmin();
    }

    match /vts_admin/eden_x1_votes/records/{voteId} {
      allow get: if isAdmin() || canGetOwnEdenX1Vote(voteId);
      allow list, delete: if isAdmin();
      allow create: if signedIn()
        && validEdenX1Vote()
        && validEdenX1VotePath(voteId);
      allow update: if signedIn()
        && validEdenX1Vote()
        && validEdenX1VotePath(voteId)
        && (isAdmin() || resource.data.voterAuthUid == request.auth.uid);
    }

    match /vts_admin/eden_x1_vote_history/records/{historyId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && validEdenX1VoteHistory()
        && validEdenX1VoteHistoryPath(historyId);
      allow update, delete: if false;
    }

    match /vts_admin/eden_x1_vote_settings {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validEdenX1VoteSettings();
      allow delete: if false;
    }

    match /vts_admin/eden_x1_public_vote_results {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validEdenX1PublicVoteResults();
      allow delete: if false;
    }

    match /arcade_scores/{scoreId} {
      // Any signed-in (incl. anonymous) visitor can read the leaderboard.
      allow read: if signedIn();
      // Owner creates their own row; the doc id + uid field are pinned to their auth uid.
      allow create: if signedIn() && validArcadeScore(scoreId);
      // Owner updates their own row, and only to a higher-or-equal best (monotonic).
      allow update: if signedIn()
        && validArcadeScore(scoreId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    match /vts_admin/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
